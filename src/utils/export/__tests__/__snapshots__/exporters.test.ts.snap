exports[`exportToCode snapshots > textual: kitchen-sink tree 1`] = `
"from textual.app import App, ComposeResult
from textual.containers import Grid, Horizontal, Vertical
from textual.screen import ModalScreen
from textual.widgets import Button, Checkbox, DataTable, Input, Label, ListItem, ListView, LoadingIndicator, OptionList, ProgressBar, RadioButton, Select, Static, Switch, Tabs, Tree


class ConfirmModal(ModalScreen):
    def compose(self) -> ComposeResult:
        with Vertical(id="confirm"):
            yield Static("Sure?")


class MyApp(App):
    CSS = """
    #header {
        border: round #414868;
        padding: 1;
    }

    #header > * {
        margin-right: 2;
    }

    #title {
        color: #7dcfff;
        text-style: bold;
    }

    #body {
        width: 1fr;
    }

    #files {
        border: solid red;
    }

    #controls {
        grid-size: 2 6;
    }

    #ok {
        color: red;
    }

    #prog {
        width: 24;
    }

    #empty {
        border: solid white;
    }

    #confirm {
        width: auto;
        height: auto;
        border: double red;
    }

    ConfirmModal {
        align: center middle;
    }

    .spacer {
        width: 1fr;
        height: 1fr;
    }
    """

    def compose(self) -> ComposeResult:
        with Horizontal(id="header"):
            yield Static("Say \\"hi\\" to <all>", id="title")
            yield Tabs("Dashboard", "Agent", id="nav")
        with Horizontal(id="body"):
            yield ListView(ListItem(Label("• main.rs")), ListItem(Label("• lib.rs")), initial_index=0, id="files")
            yield Tree("Explorer", id="explorer")
            yield DataTable(id="stats")
            yield OptionList("⌂ Home")
        with Grid(id="controls"):
            yield Button("OK")
            yield Button("Cancel", id="ok")
            yield Input(placeholder="type \\"here\\"...")
            yield Checkbox("Enable", value=True)
            yield RadioButton("Choice A", value=True)
            with Horizontal():
                yield Static("Dark mode")
                yield Switch(value=True)
            yield Select([("One", 0), ("Two", 1)], allow_blank=False, value=1)
            yield LoadingIndicator()
            yield ProgressBar(total=100, show_eta=False, id="prog")
            yield Static("Home / Docs")
            yield Static("", classes="spacer")
        with Vertical(id="empty"):
            pass

    def on_mount(self) -> None:
        self.query_one("#nav", Tabs).active = "tab-2"
        tree_explorer = self.query_one("#explorer", Tree)
        tree_explorer.root.expand()
        node_explorer_0_0 = tree_explorer.root.add("Root", expand=True)
        node_explorer_0_0.add_leaf("Child 1")
        node_explorer_1_1 = node_explorer_0_0.add("Child 2", expand=False)
        node_explorer_1_1.add_leaf("Nested")
        table_stats = self.query_one("#stats", DataTable)
        table_stats.add_columns("PID", "CPU")
        table_stats.add_rows([("123", "45%"), ("456", "2%")])
        self.query_one("#prog", ProgressBar).update(total=100, progress=67)
        self.push_screen(ConfirmModal())

    def on_button_pressed(self, event: Button.Pressed) -> None:
        pass


if __name__ == "__main__":
    MyApp().run()
"
`;

