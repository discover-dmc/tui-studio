        let grid_cols_chunks_area_2__5 = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Fill(1), Constraint::Fill(1)])
            .split(grid_rows_chunks_area_2_[5]);
        let block_chunks_area_3_ = Block::new().borders(Borders::ALL).border_type(BorderType::Plain).title("Empty");
        let inner_chunks_area_3_ = block_chunks_area_3_.inner(chunks_area[3]);
        frame.render_widget(block_chunks_area_3_, chunks_area[3]);
        let modal_chunks_area_4_ = Rect::new(
