"// Requires: ratatui = "0.28"
// Add to Cargo.toml: [dependencies] ratatui = { version = "0.28", features = ["crossterm"] }
use std::io;
use ratatui::{
    crossterm::event::{self, Event, KeyCode, KeyEventKind},
    layout::{Alignment, Constraint, Direction, Layout, Rect},
    style::{Color, Modifier, Style},
    widgets::{Block, BorderType, Borders, Paragraph},
    Frame,
};

fn main() -> io::Result<()> {
    let mut terminal = ratatui::init();
    loop {
        terminal.draw(ui)?;
        if let Event::Key(key) = event::read()? {
            if key.kind == KeyEventKind::Press {
                match key.code {
                    KeyCode::Char('q') | KeyCode::Esc => break,
                    _ => {}
                }
            }
        }
    }
    ratatui::restore();
    Ok(())
}

fn ui(frame: &mut Frame) {
    let area = frame.area();

}
"
`;

exports[`exportToCode snapshots > ratatui: kitchen-sink tree 1`] = `
"// Requires: ratatui = "0.28"
// Add to Cargo.toml: [dependencies] ratatui = { version = "0.28", features = ["crossterm"] }
use std::io;
use ratatui::{
    crossterm::event::{self, Event, KeyCode, KeyEventKind},
    layout::{Alignment, Constraint, Direction, Layout, Rect},
    style::{Color, Modifier, Style},
    widgets::{Block, BorderType, Borders, Gauge, List, ListItem, Paragraph, Row, Table, Tabs},
    Frame,
};

fn main() -> io::Result<()> {
    let mut terminal = ratatui::init();
    loop {
        terminal.draw(ui)?;
        if let Event::Key(key) = event::read()? {
            if key.kind == KeyEventKind::Press {
                match key.code {
                    KeyCode::Char('q') | KeyCode::Esc => break,
                    _ => {}
                }
            }
        }
    }
    ratatui::restore();
    Ok(())
}

fn ui(frame: &mut Frame) {
    let area = frame.area();
    let chunks_area = Layout::default()
        .direction(Direction::Vertical)
        .constraints([Constraint::Min(1), Constraint::Min(1), Constraint::Min(1), Constraint::Min(1), Constraint::Min(1)])
        .split(area);
        let block_chunks_area_0_ = Block::new().borders(Borders::ALL).border_type(BorderType::Rounded).title("Header").border_style(Style::default().fg(Color::Rgb(65, 72, 104)));
        let inner_chunks_area_0_ = block_chunks_area_0_.inner(chunks_area[0]);
        frame.render_widget(block_chunks_area_0_, chunks_area[0]);
        let chunks_inner_chunks_area_0_ = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Min(1), Constraint::Min(1)])
            .split(inner_chunks_area_0_);
            frame.render_widget(Paragraph::new("Say \\"hi\\" to <all>").style(Style::default().fg(Color::Rgb(125, 207, 255)).add_modifier(Modifier::BOLD)), chunks_inner_chunks_area_0_[0]);
            frame.render_widget(Tabs::new(vec!["Dashboard", "Agent"]).select(1).style(Style::default()).highlight_style(Style::default().add_modifier(Modifier::BOLD)), chunks_inner_chunks_area_0_[1]);
        let chunks_chunks_area_1_ = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Min(1), Constraint::Min(1), Constraint::Min(1), Constraint::Min(1)])
            .split(chunks_area[1]);
            frame.render_widget(List::new(vec![ListItem::new("▶ • main.rs  1"), ListItem::new("  • lib.rs  2")]).style(Style::default()).block(Block::new().borders(Borders::ALL).border_type(BorderType::Plain).title("Files").border_style(Style::default().fg(Color::Red))), chunks_chunks_area_1_[0]);
            frame.render_widget(List::new(vec![ListItem::new("▾ Root"), ListItem::new("  ├─ Child 1"), ListItem::new("  ├─ ▸ Child 2")]).style(Style::default()), chunks_chunks_area_1_[1]);
            frame.render_widget(Table::new(vec![Row::new(vec!["123", "45%"]), Row::new(vec!["456", "2%"])], [Constraint::Fill(1), Constraint::Fill(1)]).header(Row::new(vec!["PID", "CPU"]).style(Style::default().add_modifier(Modifier::BOLD))).style(Style::default()), chunks_chunks_area_1_[2]);
            frame.render_widget(List::new(vec![ListItem::new("▶ ⌂ Home  ^H")]).style(Style::default()), chunks_chunks_area_1_[3]);
        let grid_rows_chunks_area_2_ = Layout::default()
            .direction(Direction::Vertical)
            .constraints([Constraint::Fill(1), Constraint::Fill(1), Constraint::Fill(1), Constraint::Fill(1), Constraint::Fill(1), Constraint::Fill(1)])
            .split(chunks_area[2]);
        let grid_cols_chunks_area_2__0 = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Fill(1), Constraint::Fill(1)])
            .split(grid_rows_chunks_area_2_[0]);
            frame.render_widget(Paragraph::new("OK").alignment(Alignment::Center).style(Style::default()).block(Block::new().borders(Borders::ALL).border_type(BorderType::Plain).title("OK")), grid_cols_chunks_area_2__0[0]);
            frame.render_widget(Paragraph::new("Cancel").alignment(Alignment::Center).style(Style::default().fg(Color::Red)).block(Block::new().borders(Borders::ALL).border_type(BorderType::Plain).title("OK")), grid_cols_chunks_area_2__0[1]);
        let grid_cols_chunks_area_2__1 = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Fill(1), Constraint::Fill(1)])
            .split(grid_rows_chunks_area_2_[1]);
            frame.render_widget(Paragraph::new("type \\"here\\"..._").style(Style::default()), grid_cols_chunks_area_2__1[0]);
            frame.render_widget(Paragraph::new("[✓] Enable").style(Style::default()), grid_cols_chunks_area_2__1[1]);
        let grid_cols_chunks_area_2__2 = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Fill(1), Constraint::Fill(1)])
            .split(grid_rows_chunks_area_2_[2]);
            frame.render_widget(Paragraph::new("(●) Choice A").style(Style::default()), grid_cols_chunks_area_2__2[0]);
            frame.render_widget(Paragraph::new("[OFF] Dark mode").style(Style::default()), grid_cols_chunks_area_2__2[1]);
        let grid_cols_chunks_area_2__3 = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Fill(1), Constraint::Fill(1)])
            .split(grid_rows_chunks_area_2_[3]);
            frame.render_widget(Paragraph::new("Two ▼").style(Style::default()), grid_cols_chunks_area_2__3[0]);
            frame.render_widget(Paragraph::new("[====] Working").style(Style::default()), grid_cols_chunks_area_2__3[1]);
        let grid_cols_chunks_area_2__4 = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Fill(1), Constraint::Fill(1)])
            .split(grid_rows_chunks_area_2_[4]);
            frame.render_widget(Gauge::default().ratio(0.670).style(Style::default()), grid_cols_chunks_area_2__4[0]);
