          <text>123            │ 45%           </text>
          <text>456            │ 2%            </text>
        </box>
        <box>
          <text>  ⌂ Home  ^H</text>
        </box>
      </box>
      <box style={{ flexDirection: "column" }}>
        <box style={{ flexDirection: "row" }}>
